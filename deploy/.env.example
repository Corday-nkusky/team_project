# 复制为 .env 后按需修改；.env 不入库（见根 .gitignore）。
# 推荐直接运行 `node scripts/up.mjs`：它会生成本文件并填好随机密钥。

# --- 数据库 ---（必填，空值会让 compose 拒绝启动）
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=change-me-mysql-password

# --- 后端 ---
# REQUIRE_DEPS=true：启动时依赖未就绪则退出（默认，用于 compose / 部署）
# 本地无依赖调试可设 false，服务照常启动，/health 会报告降级
REQUIRE_DEPS=true
DEP_WAIT_SECONDS=90

# 签发 access token 的密钥（必填，至少 32 字符）。
# 示例值会被后端拒绝启动——先生成再填：
#   openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# 登录态有效期（秒）：access 15 分钟，refresh 30 天
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# --- 检索门槛（可选）---
# 一条切片成为「依据」前，命中的内容词覆盖率不得低于该值（默认 0.30）。
# 调低会让跨领域问题更容易误命中（独立走查 N01），请谨慎。
MIN_KEYWORD_COVERAGE=0.30
# 启用模型时，向量相似度达到该分值可作为覆盖率的补充；不能单独放行。
MIN_VECTOR_SCORE=0.55

# --- 模型网关（可选）---
# 留空也能跑通系统：问答会退化为「抽取式」回答（直接引用本班材料片段），
# 检索只用关键词。填写 LLM_API_KEY 后，其余三项必须同时提供：
#   - LLM_API_BASE：OpenAI 兼容网关根地址，需包含 /v1 等前缀；
#   - LLM_CHAT_MODEL：POST {base}/chat/completions，需支持 stream=true 的 SSE；
#   - LLM_EMBED_MODEL：POST {base}/embeddings，返回向量维度需固定。
# 模型名没有默认值；只支持对话、不支持 embeddings 的网关不能直接使用。
# 更换嵌入模型或维度后，需删除 Qdrant 集合并重索引全部材料（见 README）。
LLM_API_BASE=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBED_MODEL=
