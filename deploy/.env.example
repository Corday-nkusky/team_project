# 复制为 .env 后按需修改；.env 不入库（见根 .gitignore）。

# --- 数据库 ---
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=changeme

# --- 后端 ---
# REQUIRE_DEPS=true：启动时依赖未就绪则退出（默认，用于 compose / 部署）
# 本地无依赖调试可设 false，服务照常启动，/health 会报告降级
REQUIRE_DEPS=true
DEP_WAIT_SECONDS=90
