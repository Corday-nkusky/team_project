# 复制为 .env 后按需修改；.env 不入库（见根 .gitignore）。

# --- 数据库 ---
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=changeme

# --- 后端 ---
# REQUIRE_DEPS=true：启动时依赖未就绪则退出（默认，用于 compose / 部署）
# 本地无依赖调试可设 false，服务照常启动，/health 会报告降级
REQUIRE_DEPS=true
DEP_WAIT_SECONDS=90

# 签发 access token 的密钥。**部署务必改成随机长串**：
#   openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me

# 登录态有效期（秒）：access 15 分钟，refresh 30 天
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# --- 模型网关（可选）---
# 留空也能跑通系统：问答会退化为「抽取式」回答（直接引用本班材料片段），
# 检索只用关键词；填上后问答由模型生成，检索额外启用向量路。
# 任何 OpenAI 兼容网关都可用（OpenAI / DeepSeek / 通义 / 自建网关等）。
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
LLM_EMBED_MODEL=text-embedding-3-small
