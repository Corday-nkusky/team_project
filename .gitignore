# 构建产物
backend/bin/
*.exe

# 本地环境与运行日志
deploy/.env
.env
*.log

# 依赖与前端构建产物
node_modules/
frontend/dist/
*.tsbuildinfo

# 后端嵌入的前端产物：仓库只保留 .gitkeep，实际文件由构建写入
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# 本地开发用的一次性数据库实例数据目录
.devdb/

# 语料灌库的运行记录（由 seed-data/biology/seed.mjs 生成）
seed-data/biology/manifest.json

# WorkBuddy 本地缓存（项目记忆、脚本断点记录），与代码无关
.workbuddy/

# 内部交接单：含真实 API Key，只在成员之间私下传递，任何情况下都不入库
内部-*.md

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
